<?xml version="1.0"?>
<ruleset name="SooCool for WooCommerce">
	<description>Actionable WordPress quality and security checks for the PSR-4 SooCool plugin.</description>

	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>
	<arg name="warning-severity" value="0"/>
	<arg value="ps"/>

	<file>soocool-for-woocommerce.php</file>
	<file>src</file>
	<file>uninstall.php</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>assets/*</exclude-pattern>

	<config name="minimum_supported_wp_version" value="6.5"/>
	<config name="text_domain" value="soocool-for-woocommerce"/>

	<!-- Keep WordPress Core plus Extra security and best-practice checks. -->
	<rule ref="WordPress-Extra"/>

	<!-- src uses PSR-4 ClassName.php files rather than legacy class-foo.php names. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>src/*</exclude-pattern>
	</rule>

	<!-- Exception messages are not HTML output; keep real OutputNotEscaped checks enabled. -->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<severity>0</severity>
	</rule>

	<!--
		WooCommerce validates the checkout nonce before these checkout helpers run.
		The helper sanitizes both direct POST values and serialized post_data values.
	-->
	<rule ref="WordPress.Security.NonceVerification.Missing">
		<exclude-pattern>src/Checkout/DeliveryCheckoutRequest.php</exclude-pattern>
	</rule>

	<!--
		Plain-text email values are passed through plain_text(), which strips tags and
		sanitizes the value. HTML output in this class remains explicitly escaped.
	-->
	<rule ref="WordPress.Security.EscapeOutput.OutputNotEscaped">
		<exclude-pattern>src/Checkout/DeliveryOrderDetails.php</exclude-pattern>
	</rule>

	<!-- Intentional fallback catches: both paths continue with a bounded fallback. -->
	<rule ref="Generic.CodeAnalysis.EmptyStatement.DetectedCatch">
		<exclude-pattern>src/Infrastructure/Logger.php</exclude-pattern>
		<exclude-pattern>src/Checkout/DeliverySchedule.php</exclude-pattern>
	</rule>

	<!--
		The translator explanation for the month placeholder is adjacent to the
		sprintf() consuming it; suppress only this existing renderer file.
	-->
	<rule ref="WordPress.WP.I18n.MissingTranslatorsComment">
		<exclude-pattern>src/Checkout/DeliveryOptionsRenderer.php</exclude-pattern>
	</rule>

	<!-- Formatting-only rules are not release blockers for this existing codebase. -->
	<rule ref="WordPress.Arrays.ArrayDeclarationSpacing.AssociativeArrayFound">
		<severity>0</severity>
	</rule>
	<rule ref="PSR2.Classes.ClassDeclaration.CloseBraceAfterBody">
		<severity>0</severity>
	</rule>
	<rule ref="PSR2.Methods.FunctionClosingBrace.SpacingBeforeClose">
		<severity>0</severity>
	</rule>
	<rule ref="PSR2.Files.EndFileNewline.TooMany">
		<severity>0</severity>
	</rule>
	<rule ref="Squiz.WhiteSpace.SuperfluousWhitespace.EmptyLines">
		<severity>0</severity>
	</rule>
	<rule ref="Universal.Operators.DisallowShortTernary.Found">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.PHP.YodaConditions.NotYoda">
		<severity>0</severity>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="soocool-for-woocommerce"/>
			</property>
		</properties>
	</rule>
</ruleset>
